# Copy to ~/.hermes/.env (preferred, shared with other Hermes skills)
# or to <skill>/.env. Never commit the real file.

# --- Telegram bot: sends you digests, alerts and reminders ---------------
# Create a bot with @BotFather -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=123456789:AA...
# Your own chat id: message your bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates  and read message.chat.id
TELEGRAM_CHAT_ID=123456789

# --- Telegram user API: reads public event/stand-up channels (GramJS) ----
# Get these at https://my.telegram.org -> API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Filled in for you by: npx tsx scripts/tg-login.ts
TELEGRAM_SESSION=

# --- Database -----------------------------------------------------------
# Unset  -> SQLite at ~/.hermes/data/events-finder/events.db (default, no setup)
# Set    -> Postgres via Drizzle's node-postgres driver
# DATABASE_URL=postgres://user:pass@localhost:5432/events_finder
